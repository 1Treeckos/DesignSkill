{
  "name": "designskill",
  "version": "1.0.0",
  "description": "Claude Code and Codex skills: brief a UI look from chosen references, check it against the default-AI-UI fingerprints, and preview a change against the running app before any source file is edited",
  "type": "module",
  "bin": {
    "designskill": "bin/install.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install-skill": "node bin/install.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skill",
    "ui",
    "design",
    "screenshot",
    "playwright",
    "visual-regression",
    "before-after"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Treeckos/DesignSkill.git"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
